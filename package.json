{
  "$schema": "./schemas/package.schema.json",
  "name": "dicom-viewer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "yarn check:deploy",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:deploy": "node scripts/check-vercel-readiness.mjs",
    "verify": "yarn check:architecture && yarn lint && yarn typecheck",
    "test:sr:workflow": "node scripts/debug-viewer-cdp.mjs",
    "test:sr:tools": "node scripts/test-all-sr-tools-cdp.mjs",
    "dicom:manifest": "node scripts/generate-dicom-manifest.mjs"
  },
