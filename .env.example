# Public, build-time URL for the remote study/series API.
# Expected endpoints relative to this base: /studies, /studies/:uid,
# and /studies/:uid/series.
NEXT_PUBLIC_PACS_API_BASE=https://pacs.example.com/api

# Optional public base used only to resolve relative DICOM instance URLs.
# Prefer absolute, short-lived signed HTTPS URLs in the API response instead.
NEXT_PUBLIC_DICOM_ASSET_BASE=https://pacs.example.com/

# Server-only authentication backend. Never prefix this value with NEXT_PUBLIC_.
AUTH_BACKEND_BASE_URL=https://auth.example.com
